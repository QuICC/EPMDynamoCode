Cell[TextData[{
 "***************** ",
 StyleBox["Comparison between Mathematic and EPM code projectors  ",
  FontSlant->"Italic"],
 "***********************"
}], "Text",
 CellChangeTimes->{{3.457847854856942*^9, 3.457847892268086*^9}, {
  3.457848122553792*^9, 3.4578481256984367`*^9}, {3.489472676253929*^9, 
  3.4894727288557653`*^9}, {3.4894728500928917`*^9, 3.489472850233614*^9}, {
  3.48947831279856*^9, 3.489478324652398*^9}, {3.49154854845553*^9, 
  3.4915485505963593`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"projectorList", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<proj\>\"", ",", " ", "\"\<proj2GradTP\>\"", ",", " ", 
     "\"\<projPol2Q\>\"", ",", " ", "\"\<projPol2S\>\"", ",", " ", 
     "\"\<projTor2T\>\"", ",", " ", "\"\<projTor2CurlQ\>\"", ",", " ", 
     "\"\<projTor2CurlS\>\"", ",", " ", "\"\<projPol2CurlT\>\""}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.4915488494829473`*^9, 3.491548943716123*^9}, 
   3.491555976187421*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"projectorPlots", "[", "id_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"codeValues", ",", " ", "mathValues", ",", " ", "plots"}], "}"}],
     ",", " ", 
    RowBox[{
     RowBox[{"plots", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"l", "=", "0"}], ",", " ", 
       RowBox[{"l", " ", "\[LessEqual]", "  ", "wMaxL"}], ",", " ", 
       RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"codeValues", " ", "=", " ", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Import", "[", 
            RowBox[{"wEPMFileBase", "<>", "\"\<_\>\"", "<>", 
             RowBox[{"projectorList", "[", 
              RowBox[{"[", "id", "]"}], "]"}], "<>", "\"\<_L\>\"", "<>", 
             RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<.dat\>\""}], 
            "]"}], ",", " ", "epmPrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mathValues", " ", "=", " ", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"\"\<EPMWorland\>\"", "<>", 
            RowBox[{"ToUpperCase", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{
               RowBox[{"projectorList", "[", 
                RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}], "]"}], "<>", 
            RowBox[{"StringDrop", "[", 
             RowBox[{
              RowBox[{"projectorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"wMaxN", ",", " ", "wMaxL", ",", " ", "l"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"plots", ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"codeValues", "-", "mathValues"}], "]"}], ",", " ", 
            RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", " ", 
            RowBox[{"PlotLabel", "\[Rule]", 
             RowBox[{"\"\<Projector \>\"", "<>", 
              RowBox[{"projectorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], "<>", 
              "\"\< errors for l=\>\"", "<>", 
              RowBox[{"ToString", "[", "l", "]"}]}]}], ",", " ", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<Grid point\>\"", ",", " ", "\"\<Abs error\>\""}], 
              "}"}]}]}], "]"}]}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "plots"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4915551383645163`*^9, 3.491555167795416*^9}, {
  3.4915552814277363`*^9, 3.491555282384706*^9}}],

