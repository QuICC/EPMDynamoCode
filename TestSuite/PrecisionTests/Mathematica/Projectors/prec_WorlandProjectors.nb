  RowBox[{"projectorList", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<proj2GradTP\>\"", ",", " ", "\"\<projPol2Q\>\"", ",", " ", 
     "\"\<projPol2S\>\"", ",", " ", "\"\<projTor2T\>\"", ",", " ", 
     "\"\<projTor2CurlQ\>\"", ",", " ", "\"\<projTor2CurlS\>\"", ",", " ", 
     "\"\<projPol2CurlT\>\""}], "}"}]}], ";"}]], "Input",
