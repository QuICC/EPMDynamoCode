Cell[BoxData[
 RowBox[{
  RowBox[{"projectorPlots", "[", "id_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "codeValues", ",", " ", "mathValues", ",", " ", "errData", ",", " ", 
      "logErrData"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"errData", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", " ", 
     RowBox[{"logErrData", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"l", "=", "0"}], ",", " ", 
       RowBox[{"l", " ", "\[LessEqual]", "  ", "wMaxL"}], ",", " ", 
       RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"codeValues", " ", "=", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"BinaryReadList", "[", 
             RowBox[{
              RowBox[{"wEPMFileBase", "<>", "\"\<_\>\"", "<>", 
               RowBox[{"projectorList", "[", 
                RowBox[{"[", "id", "]"}], "]"}], "<>", "\"\<_L\>\"", "<>", 
               RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<.proj\>\""}], 
              ",", " ", "\"\<Real64\>\""}], "]"}], ",", 
            RowBox[{"wMaxN", "+", "1"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mathValues", " ", "=", " ", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"\"\<EPMWorland\>\"", "<>", 
            RowBox[{"ToUpperCase", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{
               RowBox[{"projectorList", "[", 
                RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}], "]"}], "<>", 
            RowBox[{"StringDrop", "[", 
             RowBox[{
              RowBox[{"projectorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"wMaxN", ",", " ", "wMaxL", ",", " ", "l"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"errData", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"codeValues", "-", "mathValues"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"logErrData", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{"Log10", "[", 
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"codeValues", "-", "mathValues"}], "]"}], ",", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "20"}]]}], "]"}], "]"}], ",", "5"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Infinity]"}], "\[Rule]", 
               RowBox[{"-", "20"}]}], ",", " ", 
              RowBox[{"Indeterminate", "\[Rule]", 
               RowBox[{"-", "20"}]}]}], "}"}]}], ")"}]}], "]"}], ";"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"errData", ",", " ", "logErrData"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4915551383645163`*^9, 3.491555167795416*^9}, {
  3.4915552814277363`*^9, 3.491555282384706*^9}, {3.491624443081933*^9, 
