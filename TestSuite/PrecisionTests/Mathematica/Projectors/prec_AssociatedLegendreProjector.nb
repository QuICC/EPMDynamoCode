Cell[TextData[{
 "***************** ",
 StyleBox["Comparison between Mathematic and EPM code projectors  ",
  FontSlant->"Italic"],
 "***********************"
}], "Text",
 CellChangeTimes->{{3.457847854856942*^9, 3.457847892268086*^9}, {
