Cell[BoxData[
 RowBox[{
  RowBox[{"projectorList", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<proj\>\"", ",", " ", "\"\<projS2Ph\>\"", ",", " ", 
     "\"\<projT2Ph\>\"", ",", " ", "\"\<projS2Th\>\"", ",", " ", 
     "\"\<projT2Th\>\"", ",", " ", "\"\<proj2GradPh\>\"", ",", " ", 
     "\"\<proj2GradTh\>\"", ","}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.4915488494829473`*^9, 3.491548943716123*^9}, 
   3.491555976187421*^9, {3.491564996545373*^9, 3.491565033516856*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"projectorPlots", "[", "id_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "codeValues", ",", " ", "mathValues", ",", " ", "errData", ",", " ", 
      "logErrData"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"errData", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"logErrData", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"m", "=", "0"}], ",", " ", 
       RowBox[{"m", " ", "\[LessEqual]", "  ", "alMaxM"}], ",", " ", 
       RowBox[{"m", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"codeValues", " ", "=", " ", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Import", "[", 
            RowBox[{"alEPMFileBase", "<>", "\"\<_\>\"", "<>", 
             RowBox[{"projectorList", "[", 
              RowBox[{"[", "id", "]"}], "]"}], "<>", "\"\<_M\>\"", "<>", 
             RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<.dat\>\""}], 
            "]"}], ",", " ", "epmPrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mathValues", " ", "=", " ", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"\"\<EPMALegendre\>\"", "<>", 
            RowBox[{"ToUpperCase", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{
               RowBox[{"projectorList", "[", 
                RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}], "]"}], "<>", 
            RowBox[{"StringDrop", "[", 
             RowBox[{
              RowBox[{"projectorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"alMaxL", ",", " ", "alMaxM", ",", " ", "m"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"errData", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"codeValues", "-", "mathValues"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"logErrData", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{"Log10", "[", 
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"codeValues", "-", "mathValues"}], "]"}], ",", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "20"}]]}], "]"}], "]"}], ",", "5"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Infinity]"}], "\[Rule]", 
               RowBox[{"-", "20"}]}], ",", " ", 
              RowBox[{"Indeterminate", "\[Rule]", 
               RowBox[{"-", "20"}]}]}], "}"}]}], ")"}]}], "]"}], ";"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"errData", ",", " ", "logErrData"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4915551383645163`*^9, 3.491555167795416*^9}, {
  3.4915552814277363`*^9, 3.491555282384706*^9}, {3.491565039004333*^9, 
