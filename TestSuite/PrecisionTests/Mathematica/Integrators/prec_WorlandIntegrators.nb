Cell[TextData[{
 "***************** ",
 StyleBox["Comparison between Mathematic and EPM code integrators  ",
  FontSlant->"Italic"],
 "***********************"
}], "Text",
 CellChangeTimes->{{3.457847854856942*^9, 3.457847892268086*^9}, {
  3.457848122553792*^9, 3.4578481256984367`*^9}, {3.489472676253929*^9, 
  3.4894727288557653`*^9}, {3.4894728500928917`*^9, 3.489472850233614*^9}, {
  3.48947831279856*^9, 3.489478324652398*^9}, {3.49154854845553*^9, 
  3.491548580498932*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"integratorList", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<intg\>\"", ",", " ", "\"\<intgQ2Pol\>\"", ",", " ", 
     "\"\<intgT2Tor\>\"", ",", " ", "\"\<intgQ2CurlCurlProj\>\"", ",", " ", 
     "\"\<intgS2CurlCurlProj\>\"", ",", " ", "\"\<intgT2CurlProj\>\""}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.4915486546168537`*^9, 3.49154874888383*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"integratorPlots", "[", "id_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"codeValues", ",", " ", "mathValues", ",", " ", "plots"}], "}"}],
     ",", " ", 
    RowBox[{
     RowBox[{"plots", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"l", "=", "0"}], ",", " ", 
       RowBox[{"l", " ", "\[LessEqual]", "  ", "wMaxL"}], ",", " ", 
       RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"codeValues", " ", "=", " ", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Import", "[", 
            RowBox[{"wEPMFileBase", "<>", "\"\<_\>\"", "<>", 
             RowBox[{"integratorList", "[", 
              RowBox[{"[", "id", "]"}], "]"}], "<>", "\"\<_L\>\"", "<>", 
             RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<.dat\>\""}], 
            "]"}], ",", " ", "epmPrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mathValues", " ", "=", " ", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"\"\<EPMWorland\>\"", "<>", 
            RowBox[{"ToUpperCase", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{
               RowBox[{"integratorList", "[", 
                RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}], "]"}], "<>", 
            RowBox[{"StringDrop", "[", 
             RowBox[{
              RowBox[{"integratorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"wMaxN", ",", " ", "wMaxL", ",", " ", "l"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"plots", ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"codeValues", "-", "mathValues"}], "]"}], ",", " ", 
            RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", " ", 
            RowBox[{"PlotLabel", "\[Rule]", 
             RowBox[{"\"\<Integrator \>\"", "<>", 
              RowBox[{"integratorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], "<>", 
              "\"\< errors for l=\>\"", "<>", 
              RowBox[{"ToString", "[", "l", "]"}]}]}], ",", " ", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<Grid point\>\"", ",", " ", "\"\<Abs error\>\""}], 
              "}"}]}]}], "]"}]}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "plots"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.491554359461729*^9, 3.4915544646145887`*^9}, {
  3.491554556560215*^9, 3.491554563061357*^9}, {3.4915547073577833`*^9, 
