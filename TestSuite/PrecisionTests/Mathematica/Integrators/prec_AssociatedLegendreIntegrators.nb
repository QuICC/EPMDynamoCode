Cell[BoxData[
 RowBox[{
  RowBox[{"integratorList", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<intg\>\"", ",", " ", "\"\<intgTh2S\>\"", ",", " ", 
     "\"\<intgTh2T\>\"", ",", " ", "\"\<intgPh2S\>\"", ",", " ", 
     "\"\<intgPh2T\>\""}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.4915486546168537`*^9, 3.49154874888383*^9}, {
  3.491566530890854*^9, 3.4915665491026897`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"integratorPlots", "[", "id_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "codeValues", ",", " ", "mathValues", ",", " ", "errData", ",", " ", 
      "logErrData"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"errData", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"logErrData", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"m", "=", "0"}], ",", " ", 
       RowBox[{"m", " ", "\[LessEqual]", "  ", "alMaxM"}], ",", " ", 
       RowBox[{"m", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"codeValues", " ", "=", " ", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Import", "[", 
            RowBox[{"alEPMFileBase", "<>", "\"\<_\>\"", "<>", 
             RowBox[{"integratorList", "[", 
              RowBox[{"[", "id", "]"}], "]"}], "<>", "\"\<_M\>\"", "<>", 
             RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<.dat\>\""}], 
            "]"}], ",", " ", "epmPrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mathValues", " ", "=", " ", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"\"\<EPMALegendre\>\"", "<>", 
            RowBox[{"ToUpperCase", "[", 
             RowBox[{"StringTake", "[", 
              RowBox[{
               RowBox[{"integratorList", "[", 
                RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}], "]"}], "<>", 
            RowBox[{"StringDrop", "[", 
             RowBox[{
              RowBox[{"integratorList", "[", 
               RowBox[{"[", "id", "]"}], "]"}], ",", "1"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"alMaxL", ",", " ", "alMaxM", ",", " ", "m"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"errData", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"codeValues", "-", "mathValues"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"logErrData", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{"Log10", "[", 
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"codeValues", "-", "mathValues"}], "]"}], ",", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "20"}]]}], "]"}], "]"}], ",", "5"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Infinity]"}], "\[Rule]", 
               RowBox[{"-", "20"}]}], ",", " ", 
              RowBox[{"Indeterminate", "\[Rule]", 
               RowBox[{"-", "20"}]}]}], "}"}]}], ")"}]}], "]"}], ";"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"errData", ",", " ", "logErrData"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.491554359461729*^9, 3.4915544646145887`*^9}, {
  3.491554556560215*^9, 3.491554563061357*^9}, {3.4915547073577833`*^9, 
