 RowBox[{
  RowBox[{
   RowBox[{"schmidtNorm", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "\[Equal]", "0"}], " ", "&&", " ", 
      RowBox[{"m", " ", "\[Equal]", "0"}]}], ",", " ", "1", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "\[Equal]", "0"}], ",", " ", 
       SqrtBox[
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "m"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "m"}], ")"}], "!"}]]], ",", 
       RowBox[{
        SqrtBox["2"], 
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "-", "m"}], ")"}], "!"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "m"}], ")"}], "!"}]]]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
