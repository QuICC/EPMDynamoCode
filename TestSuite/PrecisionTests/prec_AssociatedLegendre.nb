Cell[BoxData[
 RowBox[{
  RowBox[{"maxErrPlot", "[", 
   RowBox[{"name_", ",", " ", "maxRange_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mathData", ",", "epmData", ",", "loop", ",", " ", "errData"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"errData", " ", "=", 
      RowBox[{"Table", "[", " ", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "maxRange"}], "}"}]}], "]"}]}],
      " ", ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"loop", "=", "0"}], ",", " ", 
       RowBox[{"loop", " ", "\[LessEqual]", " ", "maxRange"}], ",", " ", 
       RowBox[{"loop", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mathData", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"schmidtNorm", "[", 
             RowBox[{"l", ",", "loop"}], "]"}], 
            RowBox[{
             RowBox[{"ToExpression", "[", 
              RowBox[{"\"\<alMathProj\>\"", "<>", "name"}], "]"}], " ", "[", 
             RowBox[{"l", ",", "loop", ",", " ", 
              RowBox[{"alMathGrid", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "loop", ",", "alMaxL"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "alGridN"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"epmData", " ", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Import", "[", 
            RowBox[{
            "alEPMFileBase", "<>", "\"\<_proj\>\"", "<>", "name", "<>", 
             "\"\<_M\>\"", "<>", 
             RowBox[{"ToString", "[", "loop", "]"}], "<>", "\"\<.dat\>\""}], 
            "]"}], ",", " ", "myPrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"errData", "[", 
          RowBox[{"[", 
           RowBox[{"loop", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{"errValues", "[", 
          RowBox[{"mathData", ",", "epmData"}], "]"}]}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "errData", "]"}], ",", " ", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
       RowBox[{"PlotLegend", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Absolute\>\"", ",", " ", "\"\<Relative\>\""}], "}"}]}], 
       ",", " ", 
       RowBox[{"LegendPosition", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", "Green"}], "}"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
