Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"schmidtNorm", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "\[Equal]", "0"}], " ", "&&", " ", 
      RowBox[{"m", " ", "\[Equal]", "0"}]}], ",", " ", "1", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "\[Equal]", "0"}], ",", " ", 
       SqrtBox[
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "m"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "m"}], ")"}], "!"}]]], ",", 
       RowBox[{
        SqrtBox["2"], 
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "-", "m"}], ")"}], "!"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "m"}], ")"}], "!"}]]]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.457863518776659*^9, 3.457863605819747*^9}, {
  3.460881422680517*^9, 3.460881424405568*^9}, {3.489485711977872*^9, 
  3.489485732279031*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"alMathP", "=", 
   RowBox[{"Compile", "[", 
