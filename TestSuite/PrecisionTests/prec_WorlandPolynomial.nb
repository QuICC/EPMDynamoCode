Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"wNorm", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"n", "\[Equal]", "0"}], " ", "&&", " ", 
      RowBox[{"\[Beta]", "\[Equal]", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}]}]}], ",", 
     FractionBox["\[Pi]", "2"], ",", 
     RowBox[{
      FractionBox["1", "2"], 
      FractionBox["1", 
       RowBox[{
        RowBox[{"2", "n"}], " ", "+", "\[Alpha]", "+", "\[Beta]", "+", "1"}]], 
      FractionBox[
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "\[Alpha]", "+", "1"}], "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "\[Beta]", "+", "1"}], "]"}]}], 
       RowBox[{
        RowBox[{"n", "!"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "\[Alpha]", "+", "\[Beta]", "+", "1"}], 
         "]"}]}]]}]}], "]"}]}], ";"}]], "Input"],

