       RowBox[{
        RowBox[{"n", "!"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "\[Alpha]", "+", "\[Beta]", "+", "1"}], 
         "]"}]}]]}]}], "]"}]}], ";"}]], "Input"],

