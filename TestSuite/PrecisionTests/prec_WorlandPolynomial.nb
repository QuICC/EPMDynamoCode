Cell[BoxData[
 RowBox[{
  RowBox[{"maxErrPlot", "[", 
   RowBox[{"name_", ",", " ", "maxRange_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mathData", ",", "epmData", ",", "loop", ",", " ", "errData"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"errData", " ", "=", 
      RowBox[{"Table", "[", " ", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "maxRange"}], "}"}]}], "]"}]}],
      " ", ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"loop", "=", "0"}], ",", " ", 
       RowBox[{"loop", " ", "\[LessEqual]", " ", "maxRange"}], ",", " ", 
       RowBox[{"loop", "++"}], ",", 
       RowBox[{
        RowBox[{"mathData", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ToExpression", "[", 
             RowBox[{"\"\<wMathProj\>\"", "<>", "name"}], "]"}], "[", 
            RowBox[{"n", ",", "loop", ",", " ", 
             RowBox[{"wMathGrid", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", "wMaxN"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "wGridN"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"epmData", " ", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Import", "[", 
            RowBox[{
            "wEPMFileBase", "<>", "\"\<_proj\>\"", "<>", "name", "<>", 
             "\"\<_L\>\"", "<>", 
             RowBox[{"ToString", "[", "loop", "]"}], "<>", "\"\<.dat\>\""}], 
            "]"}], ",", " ", "myPrecision"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"errData", "[", 
          RowBox[{"[", 
           RowBox[{"loop", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{"errValues", "[", 
          RowBox[{"mathData", ",", "epmData"}], "]"}]}], ";"}]}], "]"}], ";", 
     
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "errData", "]"}], ",", " ", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
       RowBox[{"PlotLegend", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Absolute\>\"", ",", " ", "\"\<Relative\>\""}], "}"}]}], 
       ",", " ", 
       RowBox[{"LegendPosition", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", "Green"}], "}"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
